#!/bin/bash
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=12:mem=32gb:ngpus=1:gpu_type=A100

eval "$(~/miniconda3/bin/conda shell.bash hook)"

conda activate meta_causal_inf

module load cuDNN/8.6.0.163-CUDA-11.8.0

export XLA_FLAGS=--xla_gpu_cuda_data_dir=/gpfs/easybuild/prod/software/CUDA/11.8.0/

export WANDB_API_KEY="bc359b26d166ea6980eb0e231060bd7b8c06925e"

# Construct the run_name using the desired variables
RUN_NAME="DF${DF}_MT${MT}_DM${DM}_DFF${DFF}_NH${NH}_NL${NL}_NC${NC}_BS${BS}_LR${LR}"

python3 /gpfs/home/ad6013/Research/CausalInferenceNeuralProcess/CITNP/experiments/file_train.py \
    --work_dir="/gpfs/home/ad6013/Research/CausalInferenceNeuralProcess/CITNP" \
    --data_file=$DF \
    --model_type=$MT \
    --d_model=$DM \
    --dim_feedforward=$DFF \
    --nhead=$NH \
    --num_layers_encoder=$NL \
    --num_mixture_components=$NC \
    --batch_size=$BS \
    --learning_rate=$LR \
    --run_name=$RUN_NAME \
    --sample_size=500 \
    --epochs=2 \
